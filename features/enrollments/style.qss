#enrollmentView QPushButton#primaryButton {
    background: #7c3aed;
}

#enrollmentView QPushButton#primaryButton:hover {
    background: #6d28d9;
}

#enrollmentView QPushButton#secondaryButton {
    background: #eef2ff;
    border: 1px solid #c4b5fd;
    color: #5b21b6;
}

#enrollmentView QPushButton#secondaryButton:hover {
    background: #ddd6fe;
}

#enrollmentView QComboBox:focus {
    border: 2px solid #7c3aed;
}

#enrollmentView QHeaderView::section {
    background: #f3e8ff;
    color: #6b21a8;
}
