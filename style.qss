* {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
    color: #1f2937;
}

QWidget {
    background-color: #f4f7fb;
}

#mainContent {
    background-color: #f4f7fb;
}

#appHeader {
    background: #1769aa;
    border: none;
    border-radius: 10px;
}

#appTitle {
    background: transparent;
    color: #ffffff;
    font-size: 19px;
    font-weight: 700;
}

#appSubtitle {
    background: transparent;
    color: #dbeafe;
    font-size: 12px;
    font-weight: 400;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d8e1ee;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: #e9eff7;
    border: 1px solid #d8e1ee;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #526174;
    margin-right: 4px;
    min-width: 96px;
    padding: 9px 16px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1769aa;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #dce8f5;
}

QLabel {
    color: #334155;
    font-weight: 600;
}

QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    min-height: 24px;
    padding: 5px 8px;
    selection-background-color: #2563eb;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #3b82f6;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    selection-background-color: #dbeafe;
    selection-color: #1e3a5f;
}

QPushButton {
    background: #2563eb;
    border: none;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    min-height: 28px;
    padding: 6px 14px;
}

QPushButton:hover {
    background: #1d4ed8;
}

QPushButton:pressed {
    background: #1e40af;
}

QPushButton:disabled {
    background: #94a3b8;
    color: #e2e8f0;
}

#logoutButton {
    background: #ffffff;
    border: none;
    border-radius: 6px;
    color: #145a91;
    min-width: 88px;
    padding: 6px 16px;
}

#logoutButton:hover {
    background: #eaf4ff;
    color: #0f4c81;
}

#logoutButton:pressed {
    background: #dbeafe;
}

QTableWidget {
    alternate-background-color: #f8fafc;
    background: #ffffff;
    border: 1px solid #d8e1ee;
    border-radius: 6px;
    gridline-color: #e2e8f0;
    selection-background-color: #dbeafe;
    selection-color: #1e3a5f;
}

QHeaderView::section {
    background: #eaf2fb;
    border: none;
    border-bottom: 1px solid #d8e1ee;
    color: #334155;
    font-weight: 700;
    padding: 8px;
}

QScrollBar:vertical {
    background: #f1f5f9;
    border: none;
    margin: 2px;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #94a3b8;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QMessageBox {
    background: #ffffff;
}
